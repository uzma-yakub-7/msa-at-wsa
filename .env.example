# ---------------------------------------------------------------------------
# Copy this file to ".env" for local development.
# On Vercel, set these same names under Project Settings -> Environment Variables.
# Never commit a real .env file — it's already in .gitignore.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Get this from your Neon project dashboard -> Connection Details.
# Use the POOLED connection string (it usually has "-pooler" in the hostname) —
# that's the one meant for serverless apps like this one.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Username + password for the /admin page (protected with Basic Auth).
# Pick your own values — this is what MSA officers will type in to manage
# events and leadership. Change ADMIN_PASSWORD before you deploy for real.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-deploying
